---
import Tag from '../../components/Tag.astro';
import Page from '../../layouts/Page.astro';
import { getPosts } from '../../lib/blog';
import { formatPostDate, readingMinutes } from '../../lib/posts';

const posts = await getPosts();
---

<Page
  title="Blog"
  description="Notes on backend engineering, distributed systems and algorithms."
  noindex={posts.length === 0}
>
  <h1>Blog</h1>
  <p class="intro">Notes on backend engineering, distributed systems and algorithms.</p>
  {posts.length === 0 ? (
    <p class="empty">No posts yet. New posts will appear here.</p>
  ) : (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <h2>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            {post.data.draft && <span class="draft">Draft</span>}
          </h2>
          <p class="meta">
            <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time> ·{' '}
            {readingMinutes(post.body ?? '')} min read
          </p>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {post.data.tags.map((tag) => (
                <li>
                  <Tag>{tag}</Tag>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  )}
</Page>

<style>
  h1 {
    font-size: var(--text-2xl);
  }

  .intro,
  .empty {
    margin-top: var(--space-2);
    color: var(--color-muted);
  }

  .empty {
    margin-top: var(--space-6);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts {
    margin-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .posts > li {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-line);
  }

  h2 {
    font-size: 1.15rem;
  }

  h2 a {
    color: var(--color-ink);
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-2);
  }

  .draft {
    margin-left: var(--space-2);
    padding: 1px 8px;
    border: 1px dashed var(--color-faint);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    vertical-align: 3px;
  }
</style>
