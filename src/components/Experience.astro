---
import SectionHeading from './SectionHeading.astro';
import Tag from './Tag.astro';
import type { Experience } from '../content/schemas';
import {
  companySpan,
  formatDuration,
  formatRange,
  monthsInclusive,
  sortRolesNewestFirst,
} from '../lib/dates';

interface Props {
  companies: Experience[];
  today?: Date;
}

const { companies, today = new Date() } = Astro.props;
const ordered = [...companies].sort((a, b) => a.order - b.order);
---

<section id="experience" aria-labelledby="experience-title">
  <SectionHeading id="experience-title" title="Experience" />
  <div class="companies">
    {ordered.map((company) => {
      const span = companySpan(company.roles);
      return (
        <article class="company">
          <div class="logo" aria-hidden="true">
            {company.company.charAt(0)}
          </div>
          <header>
            <h3>
              <a href={company.url} target="_blank" rel="noopener noreferrer">
                {company.company}
              </a>
            </h3>
            <p class="meta">
              {company.industry} · {company.location} · {formatRange(span.start, span.end)} ·{' '}
              {formatDuration(monthsInclusive(span.start, span.end, today))}
            </p>
          </header>
          <ol class="roles">
            {sortRolesNewestFirst(company.roles).map((role) => (
              <li class:list={['role', { current: role.end === null }]}>
                <div class="role-top">
                  <h4>{role.title}</h4>
                  <span class="dates">{formatRange(role.start, role.end)}</span>
                </div>
                {role.bullets.length > 0 && (
                  <ul class="bullets">
                    {role.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
                {role.tools.length > 0 && (
                  <ul class="tools" aria-label="Tools">
                    {role.tools.map((tool) => (
                      <li>
                        <Tag>{tool}</Tag>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </article>
      );
    })}
  </div>
</section>

<style>
  .companies {
    display: grid;
    gap: var(--space-7);
  }

  .company {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: start;
  }

  header {
    min-width: 0;
  }

  .logo {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-line-strong);
    border-radius: 10px;
    background: var(--color-panel);
    color: var(--color-ink);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
  }

  h3 a {
    color: inherit;
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  ol,
  ul {
    margin: 0;
    padding: 0;
  }

  .roles {
    grid-column: 2;
    display: grid;
    gap: 22px;
    margin-top: 18px;
    padding-left: 22px;
    border-left: 1px solid var(--color-line-strong);
    list-style: none;
  }

  .role {
    position: relative;
  }

  .role::before {
    content: '';
    position: absolute;
    left: -27px;
    top: 8px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--color-line-strong);
    border-radius: 50%;
    background: var(--color-bg);
  }

  .role.current::before {
    border-color: var(--color-accent);
  }

  .role-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }

  h4 {
    font-size: 1rem;
    font-weight: 600;
  }

  .dates {
    color: var(--color-muted);
    font: var(--text-xs) / 1.9 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .bullets {
    margin-top: var(--space-2);
    padding-left: 18px;
    list-style: disc;
  }

  .bullets li {
    margin: 4px 0;
  }

  .bullets li::marker {
    color: var(--color-faint);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-3);
    list-style: none;
  }

  @media (max-width: 640px) {
    .roles {
      grid-column: 1 / -1;
      margin-left: 5px;
    }
  }
</style>
