---
import type { RatingPoint } from '../lib/cp/types';
import { buildRatingChart, codeforcesRank } from '../lib/chart';
import { formatMonth } from '../lib/dates';

interface Props {
  history: RatingPoint[];
}

const { history } = Astro.props;
const width = 440;
const height = 240;
const chart = buildRatingChart(history, {
  width,
  height,
  padding: { top: 8, right: 8, bottom: 22, left: 38 },
});
const first = history[0];
const last = history.at(-1);
const month = (iso: string) => formatMonth(iso.slice(0, 7));
const description =
  first && last
    ? `Rating went from ${first.rating} in ${month(first.date)} to ${last.rating} in ${month(last.date)} over ${history.length} contests. Peak ${chart.peak.rating} (${codeforcesRank(chart.peak.rating).name}) in ${month(chart.peak.date)}.`
    : '';
---

<figure class="rating-chart">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="rating-title rating-desc">
    <title id="rating-title">Codeforces rating history</title>
    <desc id="rating-desc">{description}</desc>
    {chart.bands.map((band) => (
      <rect
        x={chart.left}
        y={band.y}
        width={chart.right - chart.left}
        height={band.height}
        fill={band.color}
        fill-opacity="0.1"
      />
    ))}
    {chart.yTicks.map((tick) => (
      <g>
        <line x1={chart.left} x2={chart.right} y1={tick.y} y2={tick.y} stroke="var(--color-line)" />
        <text x={chart.left - 6} y={tick.y + 3.5} text-anchor="end">
          {tick.value}
        </text>
      </g>
    ))}
    {chart.xTicks.map((tick) => (
      <text x={tick.x} y={height - 6} text-anchor="middle">
        {tick.label}
      </text>
    ))}
    <path d={chart.area} class="area"></path>
    <path d={chart.line} class="line"></path>
    <circle cx={chart.peak.x} cy={chart.peak.y} r="3.5" class="peak"></circle>
  </svg>
  <details>
    <summary>Show the rating history as a table</summary>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Contest</th>
            <th scope="col">Rating</th>
          </tr>
        </thead>
        <tbody>
          {[...history].reverse().map((point) => (
            <tr>
              <td>{month(point.date)}</td>
              <td>{point.contestName}</td>
              <td>{point.rating}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  figure {
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--space-2);
    overflow: visible;
  }

  text {
    fill: var(--color-muted);
    font: 10.5px var(--font-mono);
  }

  .area {
    fill: var(--color-accent);
    fill-opacity: 0.07;
  }

  .line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .peak {
    fill: var(--color-accent);
  }

  details {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
  }

  summary {
    color: var(--color-muted);
    cursor: pointer;
  }

  .table-wrap {
    max-height: 260px;
    margin-top: var(--space-2);
    overflow: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: 4px 8px;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
  }

  th {
    position: sticky;
    top: 0;
    background: var(--color-panel);
    color: var(--color-ink);
  }
</style>
