---
import Button from './Button.astro';
import Icon from './Icon.astro';
import SectionNav from './SectionNav.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { Profile } from '../content/schemas';
import type { Section } from '../lib/sections';
import { isExternal, socialIcons } from '../lib/socials';

interface Props {
  profile: Profile;
  sections: Section[];
}

const { profile, sections } = Astro.props;
---

<aside class="sidebar">
  <div class="inner">
    <div class="photo" role="img" aria-label={`Photo of ${profile.name}`}>
      <Icon name="user" size={52} />
    </div>

    <div class="who">
      <h1>{profile.name}</h1>
      <p class="role">{profile.role}</p>
    </div>

    <ul class="facts">
      <li>
        <Icon name="location" />
        {profile.location}
      </li>
      <li>
        <Icon name="briefcase" />
        <a href={profile.employer.url} target="_blank" rel="noopener noreferrer">
          {profile.employer.name}
        </a>
      </li>
      <li class="available">
        <span class="dot" aria-hidden="true"></span>
        {profile.availability}
      </li>
    </ul>

    <div class="actions">
      <Button variant="primary" icon="download" href={profile.cvPath}>
        Download CV
      </Button>
      <Button href="#contact">Contact</Button>
    </div>

    <SectionNav sections={sections} />

    <div class="footer">
      <ul class="socials">
        {profile.socials.map((social) => (
          <li>
            <a
              href={social.url}
              aria-label={social.label}
              title={social.label}
              target={isExternal(social.url) ? '_blank' : undefined}
              rel={isExternal(social.url) ? 'noopener noreferrer' : undefined}
            >
              <Icon name={socialIcons[social.kind]} />
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </div>
</aside>

<style>
  .sidebar {
    background: var(--color-panel);
    border-right: 1px solid var(--color-line);
  }

  .inner {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    height: 100vh;
    height: 100dvh;
    overflow-y: auto;
    padding: 40px var(--space-6) 28px max(var(--space-6), env(safe-area-inset-left, 0px));
  }

  .inner > * {
    flex-shrink: 0;
  }

  .photo {
    display: grid;
    place-items: center;
    width: 104px;
    height: 104px;
    border: 1px solid var(--color-line-strong);
    border-radius: 14px;
    background: var(--color-bg);
    color: var(--color-faint);
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .role {
    margin-top: var(--space-1);
    color: var(--color-text);
    font-weight: 500;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts {
    display: grid;
    gap: 6px;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .facts a {
    color: inherit;
  }

  .available {
    color: var(--color-ok);
    font-weight: 500;
  }

  .dot {
    width: 8px;
    height: 8px;
    margin: 0 4px;
    border-radius: 50%;
    background: var(--color-ok);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sidebar :global(.section-nav) {
    padding-top: 18px;
    border-top: 1px solid var(--color-line);
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--color-line);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-muted);
  }

  .socials a:hover {
    border-color: var(--color-faint);
    color: var(--color-ink);
  }

  @media (max-width: 1000px) {
    .sidebar {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .inner {
      position: static;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 20px;
      row-gap: 18px;
      height: auto;
      padding: 28px max(20px, env(safe-area-inset-right, 0px)) 24px
        max(20px, env(safe-area-inset-left, 0px));
    }

    .who {
      align-self: center;
    }

    .facts,
    .actions,
    .footer {
      grid-column: 1 / -1;
    }

    .sidebar :global(.section-nav) {
      display: none;
    }

    .photo {
      width: 80px;
      height: 80px;
    }
  }
</style>
