---
import { Image } from 'astro:assets';
import photo from '../assets/profile.jpg';
import Button from './Button.astro';
import Icon from './Icon.astro';
import SectionNav from './SectionNav.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { Profile } from '../content/schemas';
import type { Section } from '../lib/sections';
import { isExternal, socialIcons } from '../lib/socials';

interface Props {
  profile: Profile;
  sections: Section[];
}

const { profile, sections } = Astro.props;
---

<aside class="sidebar">
  <div class="inner">
    <Image
      class="photo"
      src={photo}
      alt={`Photo of ${profile.name}`}
      widths={[120, 240]}
      sizes="120px"
      loading="eager"
      fetchpriority="high"
    />

    <div class="who">
      <h1>{profile.name}</h1>
      <p class="role">{profile.role}</p>
    </div>

    <ul class="facts">
      <li>
        <Icon name="location" />
        {profile.location}
      </li>
      <li>
        <Icon name="briefcase" />
        <a href={profile.employer.url} target="_blank" rel="noopener noreferrer">
          {profile.employer.name}
        </a>
      </li>
      <li class="available">
        <span class="dot" aria-hidden="true"></span>
        {profile.availability}
      </li>
    </ul>

    <div class="actions">
      <Button variant="primary" icon="download" href={profile.cvPath}>
        Download CV
      </Button>
      <Button href="#contact">Contact</Button>
    </div>

    <SectionNav sections={sections} />

    <div class="footer">
      <ul class="socials">
        {profile.socials.map((social) => (
          <li>
            <a
              href={social.url}
              aria-label={social.label}
              title={social.label}
              target={isExternal(social.url) ? '_blank' : undefined}
              rel={isExternal(social.url) ? 'noopener noreferrer' : undefined}
            >
              <Icon name={socialIcons[social.kind]} />
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </div>
</aside>

<style>
  .sidebar {
    --color-ink: var(--side-ink);
    --color-text: var(--side-text);
    --color-muted: var(--side-muted);
    --color-faint: var(--side-muted);
    --color-line: var(--side-line);
    --color-line-strong: var(--side-line-strong);
    --color-bg: var(--side-raise);
    --color-ok: var(--side-ok);

    position: sticky;
    top: max(24px, env(safe-area-inset-top, 0px));
    border: 1px solid var(--side-line);
    border-radius: 16px;
    background: var(--side-bg);
    color: var(--color-text);
    overflow: hidden;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-height: calc(100vh - 48px);
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
    padding: 28px 24px 22px;
  }

  .inner > * {
    flex-shrink: 0;
  }

  .photo {
    width: 120px;
    height: 120px;
    border: 3px solid var(--side-line-strong);
    border-radius: 50%;
    background: #fff;
    object-fit: cover;
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .role {
    margin-top: var(--space-1);
    color: var(--color-muted);
    font-weight: 500;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts {
    display: grid;
    gap: 6px;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .facts a {
    color: inherit;
  }

  .available {
    color: var(--color-ink);
    font-weight: 500;
  }

  .dot {
    width: 8px;
    height: 8px;
    margin: 0 4px;
    border-radius: 50%;
    background: var(--color-ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-ok) 25%, transparent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sidebar :global(.section-nav) {
    padding-top: 18px;
    border-top: 1px solid var(--color-line);
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--color-line);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-muted);
  }

  .socials a:hover {
    border-color: var(--color-muted);
    color: var(--color-ink);
  }

  @media (max-width: 1000px) {
    .sidebar {
      position: static;
    }

    .inner {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 20px;
      row-gap: 18px;
      max-height: none;
      padding: 24px 20px 20px;
    }

    .who {
      align-self: center;
    }

    .facts,
    .actions,
    .footer {
      grid-column: 1 / -1;
    }

    .sidebar :global(.section-nav) {
      display: none;
    }

    .photo {
      width: 88px;
      height: 88px;
    }
  }
</style>
