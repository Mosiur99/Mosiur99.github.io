---
import { getCollection, getEntry } from 'astro:content';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Home from '../layouts/Home.astro';
import { sections } from '../lib/sections';

const entry = await getEntry('profile', 'main');
if (!entry) throw new Error('src/content/profile.yaml must have a "main" entry');
const profile = entry.data;
const companies = (await getCollection('experience')).map((company) => company.data);

const built = new Set(['about', 'experience']);
---

<Home profile={profile}>
  <About profile={profile} />
  <Experience companies={companies} />
  {sections
    .filter((section) => !built.has(section.id))
    .map((section) => (
      <section id={section.id} aria-labelledby={`${section.id}-title`}>
        <SectionHeading id={`${section.id}-title`} title={section.label} />
      </section>
    ))}
</Home>
