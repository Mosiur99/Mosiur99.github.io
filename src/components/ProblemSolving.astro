---
import RatingChart from './RatingChart.astro';
import SectionHeading from './SectionHeading.astro';
import { codeforcesRank } from '../lib/chart';
import { platformLogos, platformNames } from '../lib/cp/platforms';
import { ratingTitle } from '../lib/cp/ranks';
import type { CpStats } from '../lib/cp/types';
import { formatMonth } from '../lib/dates';

interface Props {
  stats: CpStats;
}

const { stats } = Astro.props;
const codeforces = stats.platforms.find((p) => p.platform === 'codeforces');
const platforms = [...stats.platforms].sort((a, b) => b.solved - a.solved);
const month = (iso: string) => formatMonth(iso.slice(0, 7));
const live = platforms.filter((p) => p.source === 'api').map((p) => platformNames[p.platform]);
const byHand = platforms.filter((p) => p.source !== 'api');
const rated = platforms
  .map((p) => {
    const peak = p.maxRating ?? p.rating;
    const title = peak === undefined ? undefined : ratingTitle(p.platform, peak);
    return peak !== undefined && title !== undefined ? { ...p, peak, title } : undefined;
  })
  .filter((p) => p !== undefined)
  .slice(0, 3);
---

<section id="problem-solving" aria-labelledby="problem-solving-title">
  <SectionHeading
    id="problem-solving-title"
    title="Problem Solving"
    subtitle={`Competitive programming profiles, updated ${month(stats.fetchedAt)}`}
  />

  <div class="top">
    <div class="total">
      <b class="number">{stats.totalSolved.toLocaleString('en-US')}</b>
      <h3>Algorithmic problems solved</h3>
      <p>
        Across {platforms.length} online judges. {live.join(', ')} update daily.
        {byHand.length > 0 &&
          ` ${byHand.map((p) => platformNames[p.platform]).join(', ')} as of ${month(byHand[0]?.asOf ?? stats.fetchedAt)}.`}
      </p>
    </div>
    {rated.length > 0 && (
      <ul class="rated">
        {rated.map((p) => (
          <li class="rating surface">
            <div class="who">
              <img src={platformLogos[p.platform]} alt="" width="26" height="26" />
              <span>
                <b>{platformNames[p.platform]}</b>
                <span class="handle">@{p.handle}</span>
              </span>
            </div>
            <p class="title">
              {p.platform === 'codeforces' && (
                <i class={`dot rank-${codeforcesRank(p.peak).slug}`} aria-hidden="true" />
              )}
              {p.title}
            </p>
            <dl>
              <div>
                <dt>Peak rating</dt>
                <dd>{p.peak}</dd>
              </div>
              <div>
                <dt>Solved</dt>
                <dd>{p.solved.toLocaleString('en-US')}</dd>
              </div>
            </dl>
            <a class="out-link" href={p.url} target="_blank" rel="noopener noreferrer">
              View profile<span class="visually-hidden"> on {platformNames[p.platform]}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  <h3 class="sub-title">Problems solved by judge</h3>
  <ul class="judges">
    {platforms.map((p) => (
      <li>
        <a class="judge" href={p.url} target="_blank" rel="noopener noreferrer">
          <img src={platformLogos[p.platform]} alt="" width="40" height="40" />
          <span class="judge-name">{platformNames[p.platform]}</span>
          <span class="handle">
            {p.handle.split('_').map((part, i) => (
              <>
                {i > 0 && (
                  <>
                    _<wbr />
                  </>
                )}
                {part}
              </>
            ))}
          </span>
          <span class="count">
            <b>{p.solved.toLocaleString('en-US')}</b> solved
            {p.source === 'cached' && (
              <span class="note" title={`Last updated ${month(p.asOf)}`}>
                {' '}
                (cached)
              </span>
            )}
          </span>
        </a>
      </li>
    ))}
  </ul>

  {codeforces && stats.codeforcesHistory.length > 0 && (
    <div class="chart surface">
      <div class="plot">
        <RatingChart history={stats.codeforcesHistory} />
      </div>
      <div class="chart-info">
        <h3>Codeforces rating</h3>
        <dl>
          {codeforces.maxRating && (
            <div>
              <dt>Peak</dt>
              <dd>
                <i
                  class={`dot rank-${codeforcesRank(codeforces.maxRating).slug}`}
                  aria-hidden="true"
                />
                {codeforces.maxRating} · {codeforcesRank(codeforces.maxRating).name}
              </dd>
            </div>
          )}
          {codeforces.rating && (
            <div>
              <dt>Now</dt>
              <dd>{codeforces.rating}</dd>
            </div>
          )}
          <div>
            <dt>Rated contests</dt>
            <dd>{stats.codeforcesHistory.length}</dd>
          </div>
        </dl>
      </div>
    </div>
  )}
</section>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .top {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    align-items: start;
    gap: 28px;
  }

  .total {
    padding-right: 24px;
    border-right: 1px solid var(--color-line);
  }

  .number {
    display: block;
    font: 700 3.25rem / 1 var(--font-display);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .total h3 {
    margin-top: 10px;
    font-size: 1.1875rem;
    font-weight: 600;
  }

  .total p {
    margin-top: 10px;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .rated {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .rating {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 20px;
  }

  .rating .out-link {
    align-self: flex-start;
    margin-top: 6px;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .who img {
    width: 42px;
    height: 42px;
    padding: 8px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: #fff;
    object-fit: contain;
  }

  .who > span {
    display: grid;
    min-width: 0;
  }

  .who .handle {
    font-family: var(--font-sans);
  }

  .title {
    display: flex;
    align-items: center;
    margin: 10px 0 4px;
    color: var(--color-ink);
    font: 600 1.1875rem / 1.2 var(--font-display);
  }

  dl {
    margin: 0;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 0;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-xs);
  }

  dt {
    color: var(--color-muted);
  }

  dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .sub-title {
    margin: 36px 0 14px;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .judges {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .judge {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: center;
    gap: 2px 12px;
    height: 100%;
    padding: 14px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: var(--color-bg);
    box-shadow: var(--shadow-soft);
    color: var(--color-text);
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .judge:hover {
    border-color: var(--color-line-strong);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .judge img {
    grid-row: span 2;
    width: 40px;
    height: 40px;
    padding: 7px;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: #fff;
    object-fit: contain;
  }

  .judge-name {
    color: var(--color-ink);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.2;
  }

  .handle {
    color: var(--color-muted);
    font: var(--text-xs) / 1.3 var(--font-mono);
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  .count {
    grid-column: 1 / -1;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .count b {
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .note {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .chart {
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 1fr);
    align-items: start;
    gap: 32px;
    margin-top: 18px;
    padding: 24px;
  }

  .chart h3 {
    margin-bottom: 10px;
    font-size: 1.1875rem;
    font-weight: 600;
  }

  .chart dd {
    display: flex;
    align-items: center;
  }

  .dot {
    display: inline-block;
    flex: none;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
  }

  .rank-newbie {
    background: var(--rank-newbie);
  }

  .rank-pupil {
    background: var(--rank-pupil);
  }

  .rank-specialist {
    background: var(--rank-specialist);
  }

  .rank-expert {
    background: var(--rank-expert);
  }

  .rank-cm {
    background: var(--rank-cm);
  }

  .rank-master {
    background: var(--rank-master);
  }

  .rank-gm {
    background: var(--rank-gm);
  }

  @media (max-width: 1000px) {
    .judges {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .chart {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .chart-info {
      order: -1;
    }

    .top {
      grid-template-columns: minmax(0, 1fr);
    }

    .total {
      padding-right: 0;
      border-right: 0;
    }
  }

  @media (max-width: 640px) {
    .rated {
      grid-template-columns: minmax(0, 1fr);
    }

    .chart {
      padding: 18px 16px;
    }
  }

  @media (max-width: 380px) {
    .judges {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .judge {
      transition: none;
    }

    .judge:hover {
      transform: none;
    }
  }
</style>
