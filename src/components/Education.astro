---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Education } from '../content/schemas';

interface Props {
  items: Education[];
}

const items = [...Astro.props.items].sort((a, b) => a.order - b.order);
const initials = (name: string) =>
  name
    .split(' ')
    .filter((word) => /^[A-Z]/.test(word))
    .map((word) => word[0])
    .join('');
---

<section id="education" aria-labelledby="education-title">
  <SectionHeading id="education-title" title="Education" />
  <ul class="surface">
    {items.map((item) => (
      <li class="item">
        <div class="logo" aria-hidden="true">
          {initials(item.institution)}
        </div>
        <div>
          <h3>
            {item.url ? (
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                {item.institution}
              </a>
            ) : (
              item.institution
            )}
          </h3>
          <p class="degree">{item.degree}</p>
          <p class="years">
            <Icon name="calendar" size={14} />
            {item.startYear} – {item.endYear}
          </p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 26px 28px;
  }

  .item + .item {
    border-top: 1px solid var(--color-line);
  }

  .logo {
    display: grid;
    flex: none;
    place-items: center;
    width: 60px;
    height: 60px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-soft);
    color: #111a35;
    font: 700 0.9375rem / 1 var(--font-display);
    letter-spacing: -0.02em;
  }

  h3 {
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  h3 a {
    color: inherit;
  }

  .degree {
    margin-top: 2px;
  }

  .years {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 560px) {
    .item {
      align-items: flex-start;
      padding: 22px 20px;
    }

    .logo {
      width: 48px;
      height: 48px;
      font-size: 0.8125rem;
    }
  }
</style>
