---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import Tag from './Tag.astro';
import type { Experience } from '../content/schemas';
import {
  companySpan,
  formatDuration,
  formatRange,
  monthsInclusive,
  sortRolesNewestFirst,
} from '../lib/dates';
import { splitEmphasis } from '../lib/emphasis';

interface Props {
  companies: Experience[];
  today?: Date;
}

const { companies, today = new Date() } = Astro.props;
const ordered = [...companies].sort((a, b) => a.order - b.order);
---

<section id="experience" aria-labelledby="experience-title">
  <SectionHeading
    id="experience-title"
    title="Work Experience"
    subtitle="Where I build and run production backend systems"
  />
  <div class="companies">
    {ordered.map((company) => {
      const span = companySpan(company.roles);
      return (
        <article class="company surface">
          <header class="side">
            {company.logo ? (
              <div class="logo wide">
                <img src={company.logo} alt={`${company.company} logo`} width="124" height="46" />
              </div>
            ) : (
              <div class="logo" aria-hidden="true">
                {company.company.charAt(0)}.
              </div>
            )}
            <h3>
              <a href={company.url} target="_blank" rel="noopener noreferrer">
                {company.company}
              </a>
            </h3>
            <ul class="facts">
              <li>
                <Icon name="calendar" size={14} />
                {formatRange(span.start, span.end)}
              </li>
              <li class="duration">
                {formatDuration(monthsInclusive(span.start, span.end, today))}
              </li>
              <li>
                <Icon name="location" size={14} />
                {company.location}
              </li>
              <li>
                <Icon name="briefcase" size={14} />
                {company.industry}
              </li>
            </ul>
          </header>
          <ol class="roles">
            {sortRolesNewestFirst(company.roles).map((role) => (
              <li class:list={['role', { current: role.end === null }]}>
                <div class="role-top">
                  <h4>{role.title}</h4>
                  <span class="dates">
                    <Icon name="calendar" size={13} />
                    {formatRange(role.start, role.end)}
                  </span>
                </div>
                {role.bullets.length > 0 && (
                  <ul class="bullets">
                    {role.bullets.map((bullet) => (
                      <li>
                        {splitEmphasis(bullet).map((part) =>
                          part.strong ? <b>{part.text}</b> : part.text,
                        )}
                      </li>
                    ))}
                  </ul>
                )}
                {role.tools.length > 0 && (
                  <ul class="tools" aria-label="Tools">
                    {role.tools.map((tool) => (
                      <li>
                        <Tag>{tool}</Tag>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </article>
      );
    })}
  </div>
</section>

<style>
  .companies {
    display: grid;
    gap: 20px;
  }

  .company {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    overflow: hidden;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border-right: 1px solid var(--color-line);
    background: var(--color-panel);
  }

  .logo {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: #fff;
    box-shadow: var(--shadow-soft);
    color: #111a35;
    font: 700 1.125rem / 1 var(--font-display);
  }

  .logo.wide {
    width: auto;
    height: auto;
    justify-self: start;
    align-self: flex-start;
    padding: 10px 14px;
  }

  .logo img {
    display: block;
    width: 124px;
    height: auto;
  }

  h3 {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  h3 a {
    color: inherit;
  }

  ol,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts {
    display: grid;
    gap: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .facts li,
  .dates {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .duration {
    margin-top: -4px;
    padding-left: 22px;
  }

  .roles {
    display: grid;
    gap: 22px;
    padding: 28px 32px;
  }

  .role + .role {
    padding-top: 22px;
    border-top: 1px dashed var(--color-line-strong);
  }

  .role-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }

  h4 {
    font-size: 1.1875rem;
    font-weight: 600;
  }

  .current h4::after {
    content: 'Current';
    margin-left: 10px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font: 600 0.6875rem / 1.6 var(--font-sans);
    vertical-align: 3px;
  }

  .dates {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .bullets {
    display: grid;
    gap: 8px;
    margin-top: 12px;
    padding-left: 18px;
    list-style: disc;
  }

  .bullets li::marker {
    color: var(--color-faint);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  @media (max-width: 760px) {
    .company {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
      padding: 22px 20px;
    }

    .roles {
      padding: 22px 20px;
    }
  }
</style>
