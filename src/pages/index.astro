---
import { getCollection, getEntry } from 'astro:content';
import About from '../components/About.astro';
import CompetitiveProgramming from '../components/CompetitiveProgramming.astro';
import Contact from '../components/Contact.astro';
import Education from '../components/Education.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Writing, { type PostSummary } from '../components/Writing.astro';
import Home from '../layouts/Home.astro';
import { getPosts } from '../lib/blog';
import { roundedLabel } from '../lib/chart';
import { cpStats } from '../lib/cp/load';
import { visibleSections } from '../lib/sections';
import { personJsonLd } from '../lib/structured-data';

const entry = await getEntry('profile', 'main');
if (!entry) throw new Error('src/content/profile.yaml must have a "main" entry');
const profile = entry.data;
const data = async <T,>(items: Promise<{ data: T }[]>) => (await items).map((item) => item.data);
const companies = await data(getCollection('experience'));
const projects = await data(getCollection('projects'));
const skills = await data(getCollection('skills'));
const achievements = await data(getCollection('achievements'));
const education = await data(getCollection('education'));
const posts: PostSummary[] = (await getPosts()).map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  date: post.data.date,
}));

const github = profile.socials.find((social) => social.kind === 'github');
if (!github) throw new Error('profile.yaml needs a GitHub link');
---

<Home
  profile={profile}
  sections={visibleSections({ hasPosts: posts.length > 0 })}
  jsonLd={personJsonLd(profile, companies, education)}
>
  <About profile={profile} stats={{ problemsSolved: roundedLabel(cpStats.totalSolved) }} />
  <Experience companies={companies} />
  <Projects projects={projects} allReposUrl={`${github.url}?tab=repositories`} />
  <Skills groups={skills} />
  <CompetitiveProgramming stats={cpStats} achievements={achievements} />
  {posts.length > 0 && <Writing posts={posts} />}
  <Education items={education} />
  <Contact profile={profile} />
</Home>
