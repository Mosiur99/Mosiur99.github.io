---
import Icon from './Icon.astro';
import ProjectLinks from './ProjectLinks.astro';
import SectionHeading from './SectionHeading.astro';
import Tag from './Tag.astro';
import type { Project } from '../content/schemas';
import { kindIcons, projectBadges, splitProjects } from '../lib/projects';

interface Props {
  projects: Project[];
  allReposUrl: string;
}

const { projects, allReposUrl } = Astro.props;
const { featured, others } = splitProjects(projects);
---

<section id="projects" aria-labelledby="projects-title">
  <SectionHeading
    id="projects-title"
    title="Projects"
    subtitle="Production-style systems and open-source work"
  >
    <a class="out-link" href={allReposUrl} target="_blank" rel="noopener noreferrer">
      All repositories
    </a>
  </SectionHeading>

  <article class="featured">
    <div class="body">
      <div class="head">
        <span class="tile" aria-hidden="true">
          <Icon name={kindIcons[featured.kind]} size={20} />
        </span>
        <div>
          <p class="eyebrow">Featured project · {projectBadges(featured).join(' · ')}</p>
          <h3>{featured.title}</h3>
        </div>
      </div>
      <p>{featured.summary}</p>
      {featured.highlights.length > 0 && (
        <ul class="highlights">
          {featured.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )}
      <ul class="tags" aria-label="Tech stack">
        {featured.stack.map((item) => (
          <li>
            <Tag>{item}</Tag>
          </li>
        ))}
      </ul>
      <ProjectLinks links={featured.links} title={featured.title} />
    </div>
    {featured.flow && (
      <div class="flow">
        <p class="eyebrow" id="featured-flow">
          Request flow
        </p>
        <ol aria-labelledby="featured-flow">
          {featured.flow.map((step, index) => (
            <li class="step">
              <span class="number" aria-hidden="true">
                {index + 1}
              </span>
              {step}
            </li>
          ))}
        </ol>
      </div>
    )}
  </article>

  <ul class="grid">
    {others.map((project) => {
      const [kind, status] = projectBadges(project);
      return (
        <li>
          <article class="card">
            <div class="head">
              <span class="tile" aria-hidden="true">
                <Icon name={kindIcons[project.kind]} size={20} />
              </span>
              <div>
                <p class="eyebrow">
                  {kind}
                  {status && <span class="status">{status}</span>}
                </p>
                <h3>{project.title}</h3>
              </div>
            </div>
            <p class="summary">{project.summary}</p>
            {project.stack.length > 0 && (
              <p class="stack">
                <span class="visually-hidden">Built with </span>
                {project.stack.join(' · ')}
              </p>
            )}
            <div class="foot">
              {project.links.length > 0 ? (
                <ProjectLinks links={project.links} title={project.title} />
              ) : (
                <span class="soon">Code not public yet</span>
              )}
            </div>
          </article>
        </li>
      );
    })}
  </ul>
</section>

<style>
  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .featured,
  .card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    overflow: hidden;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 30px;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .tile {
    display: grid;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--color-line);
    border-radius: 13px;
    background: var(--color-bg);
    box-shadow: var(--shadow-soft);
    color: var(--color-ink);
  }

  .featured h3 {
    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .highlights {
    display: grid;
    gap: 6px;
    padding-left: 18px;
    list-style: disc;
    font-size: 0.9375rem;
  }

  .highlights li::marker {
    color: var(--color-faint);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .flow {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 30px;
    border-left: 1px solid var(--color-line);
    background: var(--color-panel);
  }

  .flow ol {
    display: grid;
    gap: 8px;
    margin-top: 6px;
  }

  .step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-bg);
    color: var(--color-ink);
    font: 500 var(--text-sm) / 1.3 var(--font-mono);
  }

  .step + .step::before {
    content: '';
    position: absolute;
    left: 24px;
    top: -9px;
    height: 8px;
    border-left: 2px solid var(--color-line-strong);
  }

  .number {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font: 600 0.6875rem / 1 var(--font-sans);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 18px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 24px;
    transition:
      transform 0.15s,
      border-color 0.15s;
  }

  .card:hover {
    border-color: var(--color-line-strong);
    transform: translateY(-2px);
  }

  .card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .status {
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .summary {
    font-size: 0.9375rem;
  }

  .stack {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .foot {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--color-line);
  }

  .soon {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .featured {
      grid-template-columns: minmax(0, 1fr);
    }

    .flow {
      border-left: 0;
      border-top: 1px solid var(--color-line);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .body,
    .flow {
      padding: 22px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:hover {
      transform: none;
    }
  }
</style>
