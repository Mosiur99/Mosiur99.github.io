---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { SkillGroup } from '../content/schemas';

interface Props {
  groups: SkillGroup[];
}

const groups = [...Astro.props.groups].sort((a, b) => a.order - b.order);
---

<section id="skills" aria-labelledby="skills-title">
  <SectionHeading
    id="skills-title"
    title="Skills"
    subtitle="Tools I use to design, build and run backend services"
  />
  <dl class="skills surface">
    {groups.map((group) => (
      <div class="group">
        <dt>
          <span class="tile" aria-hidden="true">
            <Icon name={group.icon} size={14} />
          </span>
          {group.name}
        </dt>
        <dd>
          <ul>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    overflow: hidden;
  }

  .group {
    margin: 0 -1px -1px 0;
    padding: 22px 24px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  dt {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    color: var(--color-ink);
    font: 600 0.9375rem / 1.3 var(--font-display);
  }

  .tile {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  dd {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 4px 10px;
    border: 1px solid var(--color-line);
    border-radius: 9px;
    background: var(--color-bg);
    font-size: var(--text-xs);
  }

  @media (max-width: 900px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .skills {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
