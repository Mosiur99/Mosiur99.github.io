---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Tag from '../components/Tag.astro';
import { icons, type IconName } from '../lib/icons';

const colors = [
  'bg',
  'panel',
  'ink',
  'text',
  'muted',
  'faint',
  'line',
  'line-strong',
  'accent',
  'accent-soft',
  'ok',
];
const sizes = ['xs', 'sm', 'base', 'lg', 'xl', '2xl'];
const iconNames = Object.keys(icons) as IconName[];
---

<Base title="Style guide" noindex>
  <main class="guide">
    <h1>Style guide</h1>
    <p class="intro">Design tokens and base components used across the site.</p>

    <section aria-labelledby="colors">
      <SectionHeading id="colors" title="Colours">
        Follows the light or dark theme
      </SectionHeading>
      <ul class="swatches">
        {colors.map((name) => (
          <li>
            <span class={`swatch swatch-${name}`} />
            <code>--color-{name}</code>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="type">
      <SectionHeading id="type" title="Type scale" />
      <ul class="type">
        {sizes.map((size) => (
          <li class={`size-${size}`}>
            <code>--text-{size}</code> Backend Software Engineer
          </li>
        ))}
        <li class="mono">
          <code>--font-mono</code> Jul 2024 – Present · 3,500
        </li>
      </ul>
    </section>

    <section aria-labelledby="buttons">
      <SectionHeading id="buttons" title="Buttons" />
      <div class="row">
        <Button variant="primary" icon="download" href="#buttons">
          Download CV
        </Button>
        <Button href="#buttons">Contact</Button>
        <Button icon="copy">Copy email</Button>
        <Button href="https://github.com/Mosiur99" external icon="external">
          GitHub
        </Button>
      </div>
    </section>

    <section aria-labelledby="tags">
      <SectionHeading id="tags" title="Tags" />
      <div class="row">
        <Tag>Java</Tag>
        <Tag>Spring Boot</Tag>
        <Tag>Kafka</Tag>
        <Tag tone="outline">In progress</Tag>
        <Tag tone="outline">Open source</Tag>
      </div>
    </section>

    <section aria-labelledby="icons">
      <SectionHeading id="icons" title="Icons">
        {iconNames.length} icons
      </SectionHeading>
      <ul class="icons">
        {iconNames.map((name) => (
          <li>
            <Icon name={name} size={20} />
            <code>{name}</code>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>

<style>
  .guide {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-7) max(20px, env(safe-area-inset-right, 0px)) var(--space-8)
      max(20px, env(safe-area-inset-left, 0px));
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .intro {
    margin-top: var(--space-2);
    color: var(--color-muted);
  }

  section {
    margin-top: var(--space-8);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-3);
  }

  .swatches li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
  }

  .swatch {
    width: 28px;
    height: 28px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
  }

  .swatch-bg {
    background: var(--color-bg);
  }

  .swatch-panel {
    background: var(--color-panel);
  }

  .swatch-ink {
    background: var(--color-ink);
  }

  .swatch-text {
    background: var(--color-text);
  }

  .swatch-muted {
    background: var(--color-muted);
  }

  .swatch-faint {
    background: var(--color-faint);
  }

  .swatch-line {
    background: var(--color-line);
  }

  .swatch-line-strong {
    background: var(--color-line-strong);
  }

  .swatch-accent {
    background: var(--color-accent);
  }

  .swatch-accent-soft {
    background: var(--color-accent-soft);
  }

  .swatch-ok {
    background: var(--color-ok);
  }

  .size-xs {
    font-size: var(--text-xs);
  }

  .size-sm {
    font-size: var(--text-sm);
  }

  .size-base {
    font-size: var(--text-base);
  }

  .size-lg {
    font-size: var(--text-lg);
  }

  .size-xl {
    font-size: var(--text-xl);
  }

  .size-2xl {
    font-size: var(--text-2xl);
  }

  .type {
    display: grid;
    gap: var(--space-3);
    color: var(--color-ink);
  }

  .type code {
    display: inline-block;
    width: 8.5rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .mono {
    font-family: var(--font-mono);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .icons {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--space-3);
  }

  .icons li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-ink);
    font-size: var(--text-xs);
  }
</style>
