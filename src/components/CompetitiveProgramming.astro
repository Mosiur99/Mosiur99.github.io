---
import RatingChart from './RatingChart.astro';
import SectionHeading from './SectionHeading.astro';
import type { Achievement } from '../content/schemas';
import { codeforcesRank } from '../lib/chart';
import { platformLogos, platformNames } from '../lib/cp/platforms';
import type { CpStats } from '../lib/cp/types';
import { achievementDate, sortAchievements } from '../lib/achievements';
import { formatMonth } from '../lib/dates';

interface Props {
  stats: CpStats;
  achievements: Achievement[];
}

const { stats, achievements } = Astro.props;
const codeforces = stats.platforms.find((p) => p.platform === 'codeforces');
const platforms = [...stats.platforms].sort((a, b) => b.solved - a.solved);
const month = (iso: string) => formatMonth(iso.slice(0, 7));
const live = platforms.filter((p) => p.source === 'api').map((p) => platformNames[p.platform]);
const byHand = platforms.filter((p) => p.source !== 'api');
const rated = platforms.filter((p) => (p.maxRating ?? p.rating) !== undefined);
const results = sortAchievements(achievements);
---

<section id="cp" aria-labelledby="cp-title">
  <SectionHeading id="cp-title" title="Competitive programming">
    Updated {month(stats.fetchedAt)}
  </SectionHeading>

  <div class="grid">
    {codeforces && stats.codeforcesHistory.length > 0 && (
      <div class="box">
        <h3>Codeforces rating</h3>
        <p class="sub">
          {codeforces.maxRating && (
            <span>
              <i
                class={`dot rank-${codeforcesRank(codeforces.maxRating).slug}`}
                aria-hidden="true"
              />
              Max {codeforces.maxRating} ({codeforcesRank(codeforces.maxRating).name})
            </span>
          )}
          {codeforces.rating && (
            <span>
              · Now {codeforces.rating} · {stats.codeforcesHistory.length} contests
            </span>
          )}
        </p>
        <RatingChart history={stats.codeforcesHistory} />
      </div>
    )}

    {rated.length > 0 && (
      <div class="box">
        <h3>Contest ratings</h3>
        <ul class="ratings">
          {rated.map((p) => (
            <li>
              <img src={platformLogos[p.platform]} alt="" width="20" height="20" loading="lazy" />
              <span>{platformNames[p.platform]}</span>
              <b>{p.maxRating ?? p.rating}</b>
              <small>{p.maxRating ? 'max' : 'now'}</small>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <h3 class="judges-title">Problems solved</h3>
  <ul class="judges">
    {platforms.map((p) => (
      <li>
        <a class="judge" href={p.url} target="_blank" rel="noopener noreferrer">
          <img src={platformLogos[p.platform]} alt="" width="40" height="40" loading="lazy" />
          <span class="judge-name">{platformNames[p.platform]}</span>
          <span class="handle">
            {p.handle.split('_').map((part, i) => (
              <>
                {i > 0 && (
                  <>
                    _<wbr />
                  </>
                )}
                {part}
              </>
            ))}
          </span>
          <span class="count">
            <b>{p.solved.toLocaleString('en-US')}</b> solved
            {p.source === 'cached' && (
              <span class="note" title={`Last updated ${month(p.asOf)}`}>
                {' '}
                (cached)
              </span>
            )}
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p class="total">
    <b>{stats.totalSolved.toLocaleString('en-US')}</b> problems solved across {platforms.length}{' '}
    judges. {live.join(', ')} update daily.
    {byHand.length > 0 &&
      ` ${byHand.map((p) => platformNames[p.platform]).join(', ')} as of ${month(byHand[0]?.asOf ?? stats.fetchedAt)}.`}
  </p>

  <h3 class="results-title">Contests, problem setting and mentoring</h3>
  <ul class="results">
    {results.map((a) => (
      <li>
        <span class="year">{achievementDate(a)}</span>
        <span class="what">
          {a.title}
          {a.link && (
            <a class="standings" href={a.link} target="_blank" rel="noopener noreferrer">
              Standings<span class="visually-hidden"> for {a.title}</span>
            </a>
          )}
        </span>
        <span class="result">{a.result}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
    align-items: start;
    gap: 14px;
  }

  .ratings {
    display: grid;
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .ratings li {
    display: grid;
    grid-template-columns: 20px minmax(min-content, 1fr) auto auto;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .ratings li:last-child {
    border-bottom: 0;
  }

  .ratings img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .ratings b {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .ratings small {
    width: 2.2em;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .box {
    min-width: 0;
    padding: 18px 20px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0 6px;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .rank-newbie {
    background: var(--rank-newbie);
  }

  .rank-pupil {
    background: var(--rank-pupil);
  }

  .rank-specialist {
    background: var(--rank-specialist);
  }

  .rank-expert {
    background: var(--rank-expert);
  }

  .rank-cm {
    background: var(--rank-cm);
  }

  .rank-master {
    background: var(--rank-master);
  }

  .rank-gm {
    background: var(--rank-gm);
  }

  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: 50%;
  }

  .judges-title {
    margin: var(--space-6) 0 var(--space-3);
  }

  .judges {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .judge {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: center;
    gap: 2px 12px;
    height: 100%;
    padding: 14px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .judge:hover {
    border-color: var(--color-accent);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .judge img {
    grid-row: span 2;
    width: 40px;
    height: 40px;
    padding: 7px;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: #fff;
    object-fit: contain;
  }

  .judge-name {
    color: var(--color-ink);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.2;
  }

  .handle {
    color: var(--color-muted);
    font: var(--text-xs) / 1.3 var(--font-mono);
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  .count {
    grid-column: 1 / -1;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .count b {
    color: var(--color-ink);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .total {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .total b {
    color: var(--color-ink);
  }

  .note {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .results-title {
    margin: var(--space-6) 0 var(--space-3);
  }

  .results {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .results li {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: 12px 18px;
  }

  .results li + li {
    border-top: 1px solid var(--color-line);
  }

  .year {
    color: var(--color-muted);
    font: var(--text-xs) var(--font-mono);
  }

  .what {
    color: var(--color-ink);
    font-weight: 500;
  }

  .standings {
    margin-left: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 500;
    white-space: nowrap;
  }

  .standings::after {
    content: ' ↗';
  }

  .result {
    justify-self: end;
    padding: 1px 10px;
    border-radius: 99px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .judges {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .results li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2px var(--space-3);
      padding: 12px 14px;
    }

    .year {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 380px) {
    .judges {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .judge {
      transition: none;
    }

    .judge:hover {
      transform: none;
    }
  }
</style>
